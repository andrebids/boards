# Public origins. CryptPad must use two different HTTPS hostnames in production.
CPAD_MAIN_DOMAIN=https://slides.example.com
CPAD_SANDBOX_DOMAIN=https://slides-sandbox.example.com

# Bind only to loopback; the production reverse proxy owns TLS and public ports.
CPAD_HTTP_PORT=3020
CPAD_WS_PORT=3022
CPAD_SANDBOX_PORT=3023

# Pin this to the image built from infra/cryptpad/Dockerfile. Do not use latest.
CRYPTPAD_IMAGE=planka-cryptpad:2026.5.1
