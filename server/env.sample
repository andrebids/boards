# Configurações do Planka
BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres@postgres/planka
SECRET_KEY=your-secret-key-change-this

# Configurações SMTP para notificações e emails de boas-vindas
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_NAME=boards.example.com
# SMTP_SECURE=false
# SMTP_USER=boards@example.com
# SMTP_PASSWORD=replace-with-a-secret
# SMTP_FROM=Blachere Boards <boards@example.com>
# SMTP_TLS_REJECT_UNAUTHORIZED=true

# Configurações do Admin (opcional)
# DEFAULT_ADMIN_EMAIL=admin@example.com
# DEFAULT_ADMIN_PASSWORD=admin123
# DEFAULT_ADMIN_NAME=Admin User
# DEFAULT_ADMIN_USERNAME=admin

# Configurações de Log
LOG_LEVEL=info

# Configurações de Proxy (se necessário)
# TRUST_PROXY=true

# Configurações de Token
# TOKEN_EXPIRES_IN=365

# Bridge de uso semanal do Codex (gerar um segredo longo; não colocar no repositório)
# CODEX_USAGE_BRIDGE_TOKEN=

# Reposicao de palavra-passe (requer SMTP)
# PASSWORD_RESET_ENABLED=true
# PASSWORD_RESET_TOKEN_EXPIRES_IN_MINUTES=30
# PASSWORD_RESET_POLL_INTERVAL_SECONDS=5
# PASSWORD_RESET_MAX_ATTEMPTS=3

# Configurações de Idioma
# DEFAULT_LANGUAGE=pt-BR
# DEFAULT_LANGUAGE=pt-PT

# Configurações de Limite de Usuários
# ACTIVE_USERS_LIMIT=

# Limites dos anexos
# ATTACHMENT_MAX_BYTES=524288000
# DESIGN_ATTACHMENT_MAX_BYTES=524288000
# PSD_ATTACHMENT_MAX_BYTES=1073741824
# THREE_D_ATTACHMENT_MAX_BYTES=1073741824
# VIDEO_ATTACHMENT_MAX_BYTES=524288000
# ARCHIVE_ATTACHMENT_MAX_BYTES=524288000
# CHAT_ATTACHMENT_MAX_BYTES=524288000
# VIDEO_PROCESSING_ENABLED=true
# VIDEO_PROCESSING_POLL_INTERVAL_SECONDS=5
# VIDEO_PROCESSING_MAX_JOBS_PER_RUN=1
# VIDEO_PROCESSING_MAX_ATTEMPTS=3
# CHAT_ATTACHMENTS_PER_MESSAGE_LIMIT=10
# CHAT_EXTERNAL_LINK_PREVIEWS_ENABLED=false

# Observabilidade Sentry (opcional; nunca colocar conteúdo de chat nestes eventos)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Configurações de Segurança
# SHOW_DETAILED_AUTH_ERRORS=false

# Configurações do S3 (opcional)
# S3_ENDPOINT=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_FORCE_PATH_STYLE=true

# Configurações OIDC (opcional)
# OIDC_ISSUER=
