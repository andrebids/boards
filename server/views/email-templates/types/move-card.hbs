<div style="margin-bottom:16px;">
  <table role="presentation" cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td width="36" height="36" style="width:36px; height:36px; text-align:center; vertical-align:middle;">
        {{#if actor_avatar_url}}
          <img src="{{actor_avatar_url}}" width="36" height="36" alt="{{actor_name}}" style="width:36px; height:36px; border-radius:8px; display:block;">
        {{else}}
          <table role="presentation" width="36" height="36" cellpadding="0" cellspacing="0" border="0"><tr><td align="center" valign="middle" style="background-color:#dbe7ff; border-radius:8px; font:700 12px/36px Arial,sans-serif; color:#1d4ed8;">{{actor_initials}}</td></tr></table>
        {{/if}}
      </td>
      <td style="vertical-align:middle; padding-left:11px;">
        <div style="font:700 14px/20px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#263244;">{{actor_name}}</div>
        <div style="font:400 12px/18px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#7a8698;">{{email_action_moveCard}}</div>
      </td>
    </tr>
  </table>
</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f6f8fb; border-radius:7px;">
  <tr>
    <td style="padding:13px 15px;">
      <div style="font:600 12px/18px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#687386; margin-bottom:3px;">{{email_label_cardMovement}}</div>
      <div style="font:700 14px/21px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#263244;">
        {{from_list}} <span style="color:#2563eb;">&nbsp;→&nbsp;</span> {{to_list}}
      </div>
    </td>
  </tr>
</table>
