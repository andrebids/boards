<div style="margin-bottom:16px;">
  <table role="presentation" cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td width="36" height="36" style="width:36px; height:36px; text-align:center; vertical-align:middle;">
        {{#if actor_avatar_url}}
          <img src="{{actor_avatar_url}}" width="36" height="36" alt="{{actor_name}}" style="width:36px; height:36px; border-radius:8px; display:block;">
        {{else}}
          <table role="presentation" width="36" height="36" cellpadding="0" cellspacing="0" border="0"><tr><td align="center" valign="middle" style="background-color:#253451; border-radius:8px; font:700 12px/36px Arial,sans-serif; color:#a9c0ff;">{{actor_initials}}</td></tr></table>
        {{/if}}
      </td>
      <td style="vertical-align:middle; padding-left:11px;">
        <div style="font:700 14px/20px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#f1f3f6;">{{actor_name}}</div>
        <div style="font:400 12px/18px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#99a4b5;">{{email_action_commented}}</div>
      </td>
    </tr>
  </table>
</div>
<div style="padding:14px 16px; background-color:#282e39; border-radius:10px;">
  <div style="font:700 12px/18px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#a4adba; margin-bottom:5px;">{{email_label_comment}}</div>
  <div style="font:400 14px/22px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#eef1f5; text-align:left; overflow-wrap:anywhere;">“{{comment_excerpt}}”</div>
</div>
