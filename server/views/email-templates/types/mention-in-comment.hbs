<div style="margin-bottom:16px;">
  <table role="presentation" cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td width="36" height="36" style="width:36px; height:36px; text-align:center; vertical-align:middle;">
        {{#if actor_avatar_url}}
          <img src="{{actor_avatar_url}}" width="36" height="36" alt="{{actor_name}}" style="width:36px; height:36px; border-radius:8px; display:block;">
        {{else}}
          <table role="presentation" width="36" height="36" cellpadding="0" cellspacing="0" border="0"><tr><td align="center" valign="middle" style="background-color:#dbe7ff; border-radius:8px; font:700 12px/36px Arial,sans-serif; color:#1d4ed8;">{{actor_initials}}</td></tr></table>
        {{/if}}
      </td>
      <td style="vertical-align:middle; padding-left:11px;">
        <div style="font:700 14px/20px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#263244;">{{actor_name}}</div>
        <div style="font:400 12px/18px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#7a8698;">{{email_action_mentioned}}</div>
      </td>
    </tr>
  </table>
</div>
<div style="padding:14px 16px; background-color:#f6f8fb; border-left:3px solid #2563eb; border-radius:0 7px 7px 0;">
  <div style="font:700 12px/18px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#687386; margin-bottom:5px;">{{email_label_mentioned}} {{actor_name}}</div>
  <div style="font:400 14px/22px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#263244; text-align:left; overflow-wrap:anywhere;">“{{comment_excerpt}}”</div>
</div>
