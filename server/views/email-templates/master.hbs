<!doctype html>
<html lang="{{email_language}}">
<head>
  <meta charset="utf-8">
  <meta name="x-apple-disable-message-reformatting">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta http-equiv="x-ua-compatible" content="ie=edge">
  <meta name="color-scheme" content="light only">
  <meta name="supported-color-schemes" content="light">
  <title>{{notification_title}}</title>
  <style>
    :root { color-scheme:light only; supported-color-schemes:light; }
    table { border-collapse:collapse; }
    a { color:inherit; }
    .preheader { display:none!important; visibility:hidden; opacity:0; color:transparent; height:0; width:0; overflow:hidden; mso-hide:all; }
    @media (max-width:600px){
      .container { width:100%!important; }
      .stack { display:block!important; width:100%!important; box-sizing:border-box!important; border-left:0!important; border-top:1px solid #e3e8ef!important; }
      .stack-first { border-top:0!important; }
      .px { padding-left:20px!important; padding-right:20px!important; }
      .h1 { font-size:21px!important; line-height:28px!important; }
      .mobile-hide { display:none!important; }
    }
  </style>
</head>
<body style="margin:0; padding:0; background-color:#f3f5f8; color:#18212f;">
  <div class="preheader">{{actor_name}} {{action_verb}} {{action_object}} - {{project_name}}</div>
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%; background-color:#f3f5f8;">
    <tr>
      <td align="center" style="padding:32px 16px 40px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="container" style="width:100%; max-width:600px; background-color:#ffffff; border:1px solid #dde2e8; border-radius:12px;">
          <tr>
            <td style="height:4px; line-height:4px; background-color:#2563eb; border-radius:12px 12px 0 0; font-size:0;">&nbsp;</td>
          </tr>
          {{> header}}
          {{> greeting}}
          {{> notification_type}}
          {{> notification_title}}
          {{> notification_summary}}
          {{> card_details}}
          {{> footer}}
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
