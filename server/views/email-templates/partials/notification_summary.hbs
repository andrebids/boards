<!-- Contexto -->
<tr>
  <td class="px" style="padding:0 28px 22px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%; background-color:#20242d; border-radius:12px;">
      <tr>
        <td class="stack" width="{{#if is_board_notification}}50%{{else}}34%{{/if}}" style="width:{{#if is_board_notification}}50%{{else}}34%{{/if}}; padding:14px 16px; vertical-align:top;">
          <div style="font:600 11px/16px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#929dad;">Projeto</div>
          <div style="font:600 13px/19px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#f2f4f7; overflow-wrap:anywhere;">{{project_name}}</div>
        </td>
        <td class="stack" width="{{#if is_board_notification}}50%{{else}}33%{{/if}}" style="width:{{#if is_board_notification}}50%{{else}}33%{{/if}}; padding:14px 16px; vertical-align:top;">
          <div style="font:600 11px/16px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#929dad;">Board</div>
          <div style="font:600 13px/19px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#f2f4f7; overflow-wrap:anywhere;">{{board_name}}</div>
        </td>
        {{#unless is_board_notification}}
        <td class="stack" width="33%" style="width:33%; padding:14px 16px; vertical-align:top;">
          <div style="font:600 11px/16px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#929dad;">Lista</div>
          <div style="font:600 13px/19px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#f2f4f7; overflow-wrap:anywhere;">{{list_name}}</div>
        </td>
        {{/unless}}
      </tr>
    </table>
  </td>
</tr>
