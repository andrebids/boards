<!-- Contexto -->
<tr>
  <td class="px" style="padding:0 28px 22px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%; background-color:#f6f8fb; border-radius:8px;">
      <tr>
        <td class="stack stack-first" width="34%" style="width:34%; padding:12px 14px; vertical-align:top;">
          <div style="font:600 11px/16px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#7a8698;">Projeto</div>
          <div style="font:600 13px/19px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#263244; overflow-wrap:anywhere;">{{project_name}}</div>
        </td>
        <td class="stack" width="33%" style="width:33%; padding:12px 14px; vertical-align:top; border-left:1px solid #e3e8ef;">
          <div style="font:600 11px/16px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#7a8698;">Board</div>
          <div style="font:600 13px/19px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#263244; overflow-wrap:anywhere;">{{board_name}}</div>
        </td>
        <td class="stack" width="33%" style="width:33%; padding:12px 14px; vertical-align:top; border-left:1px solid #e3e8ef;">
          <div style="font:600 11px/16px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#7a8698;">Lista</div>
          <div style="font:600 13px/19px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#263244; overflow-wrap:anywhere;">{{list_name}}</div>
        </td>
      </tr>
    </table>
  </td>
</tr>
