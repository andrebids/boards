<!-- Notificação de chat -->
<tr>
  <td class="px" style="padding:14px 28px 28px;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td style="background-color:#24314b; color:#b9ceff; font:700 11px/16px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; text-transform:uppercase; padding:5px 10px; border-radius:999px;">
          {{notification_type_label}}
        </td>
      </tr>
    </table>

    <h1 class="h1" style="margin:16px 0 12px; font:700 24px/32px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#f7f8fa;">
      {{notification_title}}
    </h1>

    <p style="margin:0 0 10px; font:500 15px/22px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#b0bac8;">
      {{chat_greeting}}
    </p>
    <p style="margin:0 0 20px; font:400 14px/22px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#9da8b8;">
      {{chat_introduction}}
    </p>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%; background-color:#20242d; border-radius:12px; margin-bottom:18px;">
      <tr>
        <td class="stack" width="50%" style="width:50%; padding:14px 16px; vertical-align:top;">
          <div style="font:600 11px/16px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#929dad;">{{project_label}}</div>
          <div style="font:600 13px/19px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#f2f4f7; overflow-wrap:anywhere;">{{project_name}}</div>
        </td>
        <td class="stack" width="50%" style="width:50%; padding:14px 16px; vertical-align:top;">
          <div style="font:600 11px/16px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#929dad;">{{chat_conversation_label}}</div>
          <div style="font:600 13px/19px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#f2f4f7; overflow-wrap:anywhere;">{{chat_conversation_name}}</div>
        </td>
      </tr>
    </table>

    {{#each chat_messages}}
    <div style="margin:0 0 12px; padding:14px 16px; background-color:#242933; border-radius:12px;">
      <div style="margin-bottom:5px; font:700 13px/19px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#f1f3f6;">{{sender_name}}</div>
      <div style="white-space:pre-wrap; overflow-wrap:anywhere; font:400 14px/22px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#c7ced8;">{{preview}}</div>
    </div>
    {{/each}}

    <div style="margin-top:20px;">
      {{> cta_button}}
    </div>

    <p style="margin:18px 0 0; font:400 12px/18px -apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif; color:#8d98a9;">
      {{chat_footer}}
    </p>
  </td>
</tr>
