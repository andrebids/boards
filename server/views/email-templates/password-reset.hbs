<!doctype html>
<html lang="{{language}}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{subject}}</title>
  </head>
  <body style="margin:0;background:#f4f5f7;color:#242933;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;">{{preheader}}</div>
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
      <tr>
        <td align="center" style="padding:32px 16px;">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:560px;background:#ffffff;border-radius:10px;">
            <tr>
              <td style="padding:32px;">
                <img src="{{logo_url}}" width="64" height="64" alt="Blachere Boards" style="display:block;margin:0 0 24px;" />
                <h1 style="margin:0 0 16px;font-size:24px;line-height:32px;">{{heading}}</h1>
                <p style="margin:0 0 24px;font-size:15px;line-height:24px;">{{introduction}}</p>
                <p style="margin:0 0 24px;">
                  <a href="{{reset_url}}" style="display:inline-block;background:#2185d0;color:#ffffff;text-decoration:none;border-radius:6px;padding:12px 18px;font-weight:600;">{{button_label}}</a>
                </p>
                <p style="margin:0 0 12px;font-size:13px;line-height:20px;color:#5b6472;">{{expiry_notice}}</p>
                <p style="margin:0;font-size:13px;line-height:20px;color:#5b6472;">{{security_notice}}</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
